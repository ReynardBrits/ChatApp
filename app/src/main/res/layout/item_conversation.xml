<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/conversation_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="80dp"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/conversation_avatar_card"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants"
        app:cardBackgroundColor="@color/chat_sent"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/conversation_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/chat_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="ST" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/conversation_username"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/chat_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/conversation_avatar_card"
        app:layout_constraintEnd_toStartOf="@id/conversation_time"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/conversation_preview"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="server_test" />

    <TextView
        android:id="@+id/conversation_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/chat_text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/conversation_username"
        tools:text="8:02 AM" />

    <TextView
        android:id="@+id/conversation_preview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/chat_text_secondary"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/conversation_username"
        app:layout_constraintEnd_toStartOf="@id/conversation_unread_badge"
        app:layout_constraintTop_toBottomOf="@id/conversation_username"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_goneMarginEnd="0dp"
        tools:text="Sent a photo" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/conversation_unread_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants"
        android:visibility="gone"
        app:cardBackgroundColor="@color/chat_primary"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/conversation_preview"
        app:layout_constraintBottom_toBottomOf="@id/conversation_preview"
        tools:visibility="visible">

        <TextView
            android:id="@+id/conversation_unread_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:gravity="center"
            android:textColor="@color/chat_surface"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="2" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>